# URL pública de la API (sin barra final).
API_URL=https://tu-api.vercel.app

# Mismo valor que WORKER_TOKEN en Vercel.
WORKER_TOKEN=

# Credenciales de Cloudinary (las mismas de la API).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=instagram.com,tiktok.com,youtube.com,youtu.be

# Opcional: usuarios permitidos, separados por coma. Vacío = todos.
ALLOWED_USERS=

# Opcional: navegador del que tomar cookies (chrome, edge, firefox...).
# Déjalo vacío para intentar primero sin cookies.
COOKIES_BROWSER=
